GATE_ENVIRONMENT=testnet
# Public market feed only; private account/order requests always use GATE_ENVIRONMENT.
GATE_PUBLIC_MARKET_ENV=testnet
GATE_TESTNET_API_KEY=
GATE_TESTNET_API_SECRET=
GATE_LIVE_API_KEY=
GATE_LIVE_API_SECRET=
GATE_LIVE_TRADING_ENABLED=false
GATE_TESTNET_EXECUTE_TRADES=false
GATE_LEVERAGE=3
GATE_RISK_PROFILE=standard
GATE_SETTLE=usdt
# Keep the verified account cluster by default. Gate's SDK may list a different
# Testnet host; override this only when the credentials belong to that cluster.
GATE_TESTNET_BASE_URL=https://api-testnet.gateapi.io/api/v4
GATE_LIVE_BASE_URL=https://fx-api.gateio.ws/api/v4
GATE_PROXY_URL=
GATE_REQUIRE_PROXY=false
GATE_SSH_TUNNEL_ENABLED=false
GATE_SSH_TUNNEL_HOST=your-vps-ssh-alias
GATE_SSH_TUNNEL_LOCAL_HOST=127.0.0.1
GATE_SSH_TUNNEL_LOCAL_PORT=18081
GATE_SSH_TUNNEL_REMOTE_PORT=8888
GATE_TIMEOUT_SECONDS=10
GATE_MAX_POSITION_NOTIONAL_USD=1000
GATE_MAX_TOTAL_MARGIN_USD=100
GATE_MAX_ORDER_MARGIN_USD=25
GATE_INITIAL_CAPITAL_USD=0
GATE_MAX_PENDING_ORDER_AGE_SECONDS=1800
GATE_MAX_POSITION_AGE_SECONDS=57600
GATE_STOP_COOLDOWN_SECONDS=1800
GATE_MAX_DAILY_LOSS_USD=100
GATE_MAX_DAILY_LOSS_RATIO=0.05
# Testnet-only automatic rollback. Keep disabled until a verified policy archive hash is selected.
GATE_AUTO_ROLLBACK_ENABLED=false
GATE_AUTO_ROLLBACK_POLICY_HASH=
GATE_AUTO_ROLLBACK_MIN_TRADES=20
GATE_AUTO_ROLLBACK_MIN_PROFIT_FACTOR=0.8
GATE_AUTO_ROLLBACK_MAX_DRAWDOWN_USD=100
GATE_WEB_HOST=127.0.0.1
GATE_WEB_PORT=8081
GATE_ADMIN_PASSWORD=
